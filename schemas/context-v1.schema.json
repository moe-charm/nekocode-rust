{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moe-charm/nekocode/blob/main/schemas/context-v1.schema.json",
  "title": "NekoCode Context v1",
  "type": "object",
  "required": [
    "contract_version",
    "artifact_kind",
    "status",
    "comparison_status",
    "schema_version",
    "evidence",
    "execution_policy",
    "workspace",
    "changed_files",
    "budget",
    "limitations"
  ],
  "properties": {
    "contract_version": { "const": "context-v1" },
    "artifact_kind": { "const": "context" },
    "status": {
      "enum": [
        "not_run",
        "completed_clean",
        "completed_with_diagnostics",
        "tool_failed",
        "timed_out",
        "output_limited",
        "partial"
      ]
    },
    "comparison_status": {
      "enum": ["comparable", "baseline_missing", "not_comparable", "partial"]
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "evidence": {
      "enum": ["tool-confirmed", "semantic-resolved", "syntax-only", "incomplete"]
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "mode",
        "workspace_trust",
        "cargo_registry_network",
        "process_network_isolation",
        "environment",
        "compiler_wrappers",
        "target_directory"
      ],
      "properties": {
        "mode": { "enum": ["metadata_only", "cargo_check"] },
        "workspace_trust": { "enum": ["not_required", "required"] },
        "cargo_registry_network": { "enum": ["not_used", "offline"] },
        "process_network_isolation": {
          "enum": ["not_applicable", "not_enforced"]
        },
        "environment": { "enum": ["not_applicable", "allowlist"] },
        "compiler_wrappers": { "enum": ["not_run", "disabled"] },
        "target_directory": { "enum": ["not_used", "dedicated_temp"] }
      },
      "additionalProperties": false
    },
    "workspace": { "type": "object" },
    "changed_files": { "type": "array", "items": { "type": "object" } },
    "include_untracked_content": { "type": "boolean" },
    "diff": { "type": ["object", "null"] },
    "source_excerpts": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": ["object", "null"] },
    "diagnostic_delta": { "type": ["object", "null"] },
    "budget": { "type": "object" },
    "omissions": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
