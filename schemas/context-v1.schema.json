{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moe-charm/nekocode-rust/blob/main/schemas/context-v1.schema.json",
  "title": "NekoCode Context v1",
  "type": "object",
  "required": [
    "contract_version",
    "artifact_kind",
    "status",
    "comparison_status",
    "schema_version",
    "evidence",
    "execution_policy",
    "workspace",
    "changed_files",
    "budget",
    "limitations"
  ],
  "properties": {
    "contract_version": { "const": "context-v1" },
    "artifact_kind": { "const": "context" },
    "status": {
      "enum": [
        "not_run",
        "completed_clean",
        "completed_with_diagnostics",
        "tool_failed",
        "timed_out",
        "output_limited",
        "partial"
      ]
    },
    "comparison_status": {
      "enum": ["comparable", "baseline_missing", "not_comparable", "partial"]
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "evidence": {
      "enum": ["tool-confirmed", "semantic-resolved", "syntax-only", "incomplete"]
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "mode",
        "workspace_trust",
        "cargo_registry_network",
        "process_network_isolation",
        "environment",
        "compiler_wrappers",
        "target_directory"
      ],
      "properties": {
        "mode": { "enum": ["metadata_only", "cargo_check", "clippy"] },
        "workspace_trust": { "enum": ["not_required", "required"] },
        "cargo_registry_network": { "enum": ["not_used", "offline"] },
        "process_network_isolation": {
          "enum": ["not_applicable", "not_enforced"]
        },
        "environment": { "enum": ["not_applicable", "allowlist"] },
        "compiler_wrappers": { "enum": ["not_run", "disabled"] },
        "target_directory": { "enum": ["not_used", "dedicated_temp"] }
      },
      "additionalProperties": false
    },
    "workspace": { "type": "object" },
    "changed_files": {
      "type": "array",
      "items": { "$ref": "#/$defs/changed_file" }
    },
    "include_untracked_content": { "type": "boolean" },
    "diff": {
      "type": ["object", "null"],
      "properties": {
        "compare_ref": { "type": ["string", "null"] },
        "resolved_base": { "type": ["string", "null"] },
        "resolved_head": { "type": ["string", "null"] },
        "include_working_tree": { "type": "boolean" },
        "include_untracked_content": { "type": "boolean" },
        "patch": { "type": "string" },
        "patch_truncated": { "type": "boolean" },
        "omitted_patch_bytes": { "type": "integer", "minimum": 0 },
        "change_scopes": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/change_scope_summary" }
        },
        "provenance": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "source_excerpts": { "type": "array", "items": { "type": "object" } },
    "diagnostics": {
      "type": ["object", "null"],
      "properties": {
        "producer": { "enum": ["cargo_check", "clippy"] },
        "profile": { "enum": ["cargo_check_v1", "clippy_default_v1"] },
        "producer_version": { "type": ["string", "null"] },
        "comparison_basis": { "$ref": "#/$defs/comparison_basis" }
      },
      "additionalProperties": true
    },
    "diagnostic_producer": {
      "type": ["string", "null"],
      "enum": ["cargo_check", "clippy", null]
    },
    "diagnostic_profile": {
      "type": ["string", "null"],
      "enum": ["cargo_check_v1", "clippy_default_v1", null]
    },
    "diagnostic_delta": {
      "type": ["object", "null"],
      "properties": {
        "baseline_path": { "type": "string" },
        "status": {
          "enum": ["comparable", "baseline_missing", "not_comparable", "partial"]
        },
        "compatible": { "type": "boolean" },
        "added": { "type": "array", "items": { "type": "object" } },
        "resolved": { "type": "array", "items": { "type": "object" } },
        "persisting": { "type": "array", "items": { "type": "object" } },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/comparison_reason" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "budget": { "type": "object" },
    "omissions": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "comparison_observation_status": {
      "enum": ["observed", "absent", "unknown"]
    },
    "comparison_reason_code": {
      "enum": [
        "baseline_missing",
        "baseline_integrity_unavailable",
        "baseline_integrity_mismatch",
        "comparison_basis_unavailable",
        "toolchain_mismatch",
        "producer_mismatch",
        "producer_version_unknown",
        "producer_version_mismatch",
        "analysis_profile_mismatch",
        "package_set_mismatch",
        "target_coverage_mismatch",
        "feature_coverage_mismatch",
        "feature_definition_mismatch",
        "workspace_inputs_mismatch",
        "compiler_config_mismatch",
        "compiler_config_unknown",
        "tool_provenance_mismatch",
        "baseline_observation_incomplete",
        "current_observation_incomplete"
      ]
    },
    "comparison_reason": {
      "type": "object",
      "required": ["code", "dimension"],
      "properties": {
        "code": { "$ref": "#/$defs/comparison_reason_code" },
        "dimension": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "comparison_basis": {
      "type": "object",
      "required": [
        "workspace_members_sha256",
        "package_set_sha256",
        "package_targets_sha256",
        "feature_definitions_sha256",
        "workspace_inputs_sha256",
        "compiler_config",
        "target_coverage",
        "feature_coverage",
        "toolchain",
        "producer",
        "profile",
        "producer_version",
        "complete"
      ],
      "properties": {
        "workspace_members_sha256": { "type": "string", "minLength": 1 },
        "package_set_sha256": { "type": "string", "minLength": 1 },
        "package_targets_sha256": { "type": "string", "minLength": 1 },
        "feature_definitions_sha256": { "type": "string", "minLength": 1 },
        "workspace_inputs_sha256": { "type": "string", "minLength": 1 },
        "compiler_config": {
          "type": "object",
          "required": ["status", "sha256"],
          "properties": {
            "status": { "$ref": "#/$defs/comparison_observation_status" },
            "sha256": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "target_coverage": { "type": "string", "minLength": 1 },
        "feature_coverage": { "type": "string", "minLength": 1 },
        "toolchain": {
          "type": "object",
          "required": ["rustc_version", "cargo_version", "host"],
          "properties": {
            "rustc_version": { "type": ["string", "null"] },
            "cargo_version": { "type": ["string", "null"] },
            "host": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "producer": { "enum": ["cargo_check", "clippy"] },
        "profile": { "enum": ["cargo_check_v1", "clippy_default_v1"] },
        "producer_version": { "type": ["string", "null"] },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "git_change_scope": {
      "enum": ["revision", "staged", "unstaged", "untracked"]
    },
    "line_count_status": {
      "enum": ["counted", "binary", "not_read"]
    },
    "file_scope_change": {
      "type": "object",
      "required": [
        "scope",
        "status",
        "additions",
        "deletions",
        "line_count_status"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/git_change_scope" },
        "status": { "type": "string" },
        "additions": { "type": ["integer", "null"], "minimum": 0 },
        "deletions": { "type": ["integer", "null"], "minimum": 0 },
        "line_count_status": { "$ref": "#/$defs/line_count_status" }
      },
      "oneOf": [
        {
          "properties": {
            "additions": { "type": "integer", "minimum": 0 },
            "deletions": { "type": "integer", "minimum": 0 },
            "line_count_status": { "const": "counted" }
          }
        },
        {
          "properties": {
            "additions": { "type": "null" },
            "deletions": { "type": "null" },
            "line_count_status": { "enum": ["binary", "not_read"] }
          }
        }
      ],
      "additionalProperties": false
    },
    "changed_file": {
      "type": "object",
      "required": [
        "status",
        "path",
        "old_path",
        "is_rust",
        "package",
        "hunks"
      ],
      "properties": {
        "status": { "type": "string" },
        "path": { "type": "string" },
        "old_path": { "type": ["string", "null"] },
        "is_rust": { "type": "boolean" },
        "package": { "type": ["string", "null"] },
        "hunks": { "type": "array", "items": { "type": "object" } },
        "scope_changes": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/file_scope_change" }
        }
      },
      "additionalProperties": false
    },
    "change_scope_summary": {
      "type": "object",
      "required": [
        "scope",
        "file_count",
        "rust_file_count",
        "additions",
        "deletions",
        "counted_files",
        "binary_files",
        "not_read_files"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/git_change_scope" },
        "file_count": { "type": "integer", "minimum": 0 },
        "rust_file_count": { "type": "integer", "minimum": 0 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "counted_files": { "type": "integer", "minimum": 0 },
        "binary_files": { "type": "integer", "minimum": 0 },
        "not_read_files": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
