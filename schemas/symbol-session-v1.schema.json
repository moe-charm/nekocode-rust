{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nekocode.dev/schemas/symbol-session-v1.schema.json",
  "title": "Explicit symbol session response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "backend_reused",
    "context",
    "error"
  ],
  "properties": {
    "contract_version": {
      "const": "symbol-session-v1"
    },
    "backend_reused": {
      "type": "boolean"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "symbol-context-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition",
        "reasons",
        "retained",
        "retention_reasons"
      ],
      "properties": {
        "acquisition": {
          "enum": [
            "not_observed",
            "fresh_backend",
            "reused"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retained": {
          "type": "boolean"
        },
        "retention_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "context": {
          "type": "object"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "context": {
          "type": "null"
        },
        "error": {
          "type": "string"
        }
      }
    }
  ]
}
