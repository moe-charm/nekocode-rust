{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moe-charm/nekocode/blob/main/schemas/snapshot-v1.schema.json",
  "title": "NekoCode Snapshot v1",
  "type": "object",
  "required": [
    "contract_version",
    "artifact_kind",
    "status",
    "analysis_mode",
    "schema_version",
    "evidence",
    "execution_policy",
    "generated_at",
    "workspace",
    "limitations"
  ],
  "properties": {
    "contract_version": { "const": "snapshot-v1" },
    "artifact_kind": { "const": "snapshot" },
    "status": {
      "enum": [
        "not_run",
        "completed_clean",
        "completed_with_diagnostics",
        "tool_failed",
        "timed_out",
        "output_limited",
        "partial"
      ]
    },
    "analysis_mode": { "enum": ["metadata_only", "cargo_check"] },
    "schema_version": { "type": "integer", "minimum": 1 },
    "evidence": {
      "enum": ["tool-confirmed", "semantic-resolved", "syntax-only", "incomplete"]
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "mode",
        "workspace_trust",
        "cargo_registry_network",
        "process_network_isolation",
        "environment",
        "compiler_wrappers",
        "target_directory"
      ],
      "properties": {
        "mode": { "enum": ["metadata_only", "cargo_check"] },
        "workspace_trust": { "enum": ["not_required", "required"] },
        "cargo_registry_network": { "enum": ["not_used", "offline"] },
        "process_network_isolation": {
          "enum": ["not_applicable", "not_enforced"]
        },
        "environment": { "enum": ["not_applicable", "allowlist"] },
        "compiler_wrappers": { "enum": ["not_run", "disabled"] },
        "target_directory": { "enum": ["not_used", "dedicated_temp"] }
      },
      "additionalProperties": false
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "workspace": { "type": "object" },
    "diagnostics": { "type": ["object", "null"] },
    "canonical_hash": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "array", "items": { "type": "object" } },
    "omissions": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
