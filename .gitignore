# ⚠️ CRITICAL: Never commit these! ⚠️
# Claude Code: These patterns MUST be respected

# Build artifacts - NEVER commit
target/
build/
_deps/
obj/
*.o
*.a
*.so
*.dll
*.exe
*.lib

# Test projects - DOWNLOAD SEPARATELY 
test-real-projects/
test-projects/
test-projects-*/
*/test-real-projects/

# Other large projects
nyash/
nyash-rust/

# IDE and temporary files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Debug files
*.dSYM/
*.pdb

# Package files - too large
*.jar
*.tar.gz
*.zip
*.7z

# Sessions (can be large)
sessions/
*.session

# Backup files
*.bak
*.backup
*_backup*

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Python cache
__pycache__/
*.pyc

# IMPORTANT: Maximum file size check
# Any file > 10MB should trigger a warning!
.nekocode_sessions/

# 🚨 CRITICAL ADDITIONS (2025-08-19) 🚨
# These were MISSING and caused 3.6GB Git bloat!

# 🦀 Rust target dirs - NEVER commit (3.6GB total!)
/target/
/*/target/
/**/target/
/nekocode-workspace/target/

# 🚀 IMPORTANT: bin/ and releases/ are now INCLUDED for instant usability!
# Users can clone and immediately use pre-built binaries
# Only exclude temporary build artifacts, not final binaries

# 📊 NekoCode data dirs - Can become huge!
.nekocode_history/
.nekocode_memories/
.nekocode_cache/
/nekocode-workspace/.nekocode_history/
/nekocode-workspace/.nekocode_sessions/
/nekocode-workspace/_cli_config/
/nekocode-workspace/_temp_home/
*.nekocode_backup

# 🧪 Test workspace - HUGE (871MB)!
../test-workspace/
test-workspace/
/**/test-workspace/

# Development artifacts - DO NOT COMMIT
.cargo/
# .github/ - Allow GitHub Actions workflows
README_NEW.md
README_OLD.md
build-and-update.sh
build-smart.sh
build.rs
issue-incremental-analysis.md
